{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start backend",
      "type": "shell",
      "command": "brew services start postgresql@16 >/dev/null 2>&1; .venv/bin/python -m uvicorn backend.main:app --port 8000",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": [
          {
            "regexp": "^__never__$",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "Start demo",
      "type": "shell",
      "command": "npm install --no-audit --no-fund && npm run dev -- --open",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": [
          {
            "regexp": "^$",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*"
        }
      },
      "dependsOn": "Start backend"
    }
  ]
}